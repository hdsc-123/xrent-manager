DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Secret de signature/chiffrement des sessions JWT NextAuth (Auth.js v5) — généré
# localement, jamais partagé ni commité. Générer une valeur avec :
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Secret partagé du déclencheur de service du scheduler horaire d'alertes
# (POST /api/tasks/scheduled-alerts, Sprint 34 étape 2) — envoyé par le cron externe
# (quel qu'il soit, l'hébergeur cible reste à décider) en en-tête `Authorization: Bearer
# <secret>`. Sans cette variable, la route refuse systématiquement (503). Générer une
# valeur avec :
#   openssl rand -base64 32
CRON_SECRET="replace-with-a-generated-secret"

# Phase 3A MFA (2026-08-29) — clé de chiffrement au repos du secret TOTP (AES-256-GCM,
# src/lib/mfa-encryption.ts), également source de dérivation du pepper des codes de
# récupération (src/lib/mfa.ts). Même famille que AUTH_SECRET/CRON_SECRET : variable serveur
# uniquement, jamais NEXT_PUBLIC_*, jamais commitée. Doit décoder en exactement 32 octets une
# fois lue en base64 — générer une valeur avec :
#   openssl rand -base64 32
# Aucune route MFA n'est encore câblée à ce stade (Phase 3A = schéma et primitives
# uniquement) : cette variable n'a pas besoin d'être renseignée pour que l'application
# démarre normalement. Nom et documentation uniquement ici, volontairement sans valeur —
# consigne explicite de cette phase.
MFA_ENCRYPTION_KEY=