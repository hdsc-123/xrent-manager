generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencies     Agency[]
  users        User[]
  vehicles     Vehicle[]
  locations    Location[]
  clients      Client[]
  invoices     Invoice[]
  payments     Payment[]
  maintenances Maintenance[]
  alerts       Alert[]
}

model Agency {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  userAgencies UserAgency[]
  vehicles     Vehicle[]
  locations    Location[]
  invoices     Invoice[]
  maintenances Maintenance[]
  alerts       Alert[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String?
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  userAgencies UserAgency[]
  accounts     Account[]
  sessions     Session[]
  alerts       Alert[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserAgency {
  id        String   @id @default(cuid())
  userId    String
  agencyId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([userId, agencyId])
  @@index([agencyId])
}

// Client représente un locataire externe (personne qui loue un véhicule),
// distinct de User (compte staff du tenant, avec identifiants de connexion) —
// décision explicite Sprint 5, voir HANDOFF.md.
model Client {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  locations Location[]
  invoices  Invoice[]

  @@index([tenantId])
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id           String        @id @default(cuid())
  tenantId     String
  agencyId     String
  name         String
  licensePlate String
  make         String
  model        String
  year         Int
  category     String
  status       VehicleStatus @default(AVAILABLE)
  pricePerDay  Int
  currency     String        @default("MAD")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  agency       Agency        @relation(fields: [agencyId], references: [id])
  locations    Location[]
  maintenances Maintenance[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId])
  @@index([agencyId])
  @@index([status])
}

enum LocationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Location {
  id          String         @id @default(cuid())
  tenantId    String
  agencyId    String
  vehicleId   String
  clientId    String
  startDate   DateTime
  endDate     DateTime
  status      LocationStatus @default(PENDING)
  pricePerDay Int
  totalPrice  Int
  currency    String         @default("MAD")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  agency   Agency    @relation(fields: [agencyId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([agencyId])
  @@index([vehicleId])
  @@index([clientId])
  @@index([status])
  @@index([startDate, endDate])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  OTHER
}

// Une facture (Invoice) est liée à une Location existante ; subtotal est un snapshot du
// Location.totalPrice au moment de la création (même logique de snapshot immuable que
// Location.pricePerDay vis-à-vis de Vehicle.pricePerDay, voir DOMAINRULES.md section 14).
// agencyId/clientId/currency sont toujours dérivés de la Location côté serveur, jamais
// fournis par le client (SECURITY.md section 4).
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  agencyId       String
  locationId     String
  clientId       String
  number         String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Int
  taxRate        Int           @default(0)
  taxAmount      Int           @default(0)
  discountAmount Int           @default(0)
  totalAmount    Int
  amountPaid     Int           @default(0)
  currency       String        @default("MAD")
  issuedAt       DateTime      @default(now())
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  agency   Agency    @relation(fields: [agencyId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([agencyId])
  @@index([locationId])
  @@index([clientId])
  @@index([status])
}

// Un paiement enregistré manuellement (pas d'intégration Stripe/PayPal — décision
// explicite Sprint 6) contre une facture. Aucune donnée de carte bancaire n'est
// jamais saisie ni stockée ici (SECURITY.md) : `method`/`reference` ne décrivent que
// le mode de règlement (ex. "CARD" = paiement carte encaissé hors-ligne par l'agence).
model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  invoiceId String
  amount    Int
  currency  String        @default("MAD")
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
}

enum MaintenanceType {
  OIL_CHANGE
  TIRE_CHANGE
  INSPECTION
  REPAIR
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Suivi d'entretien d'un véhicule. agencyId est toujours dérivé du Vehicle côté
// serveur (même principe que Location.agencyId dérivé du Vehicle, voir DOMAINRULES.md
// section 7). Historique conservé : suppression bloquée dès que le statut est passé par
// IN_PROGRESS/COMPLETED (voir MaintenanceNotDeletableError, src/lib/maintenances.ts).
model Maintenance {
  id            String             @id @default(cuid())
  tenantId      String
  agencyId      String
  vehicleId     String
  type          MaintenanceType
  status        MaintenanceStatus  @default(SCHEDULED)
  scheduledDate DateTime
  completedDate DateTime?
  cost          Int?
  currency      String             @default("MAD")
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  agency  Agency  @relation(fields: [agencyId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([agencyId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

enum AlertType {
  MAINTENANCE_DUE
  RETURN_TODAY
  INVOICE_OVERDUE
  OTHER
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

// Alerte in-app (pas d'email pour ce sprint, voir HANDOFF.md). agencyId/userId sont
// optionnels : une alerte peut être diffusée à tout le tenant (agencyId/userId null),
// scopée à une agence, ou assignée à un user précis. entityType/entityId pointent en
// texte libre vers la ressource à l'origine de l'alerte (ex. "Maintenance"/id), sans
// contrainte de clé étrangère — cohérent avec Vehicle.category (DOMAINRULES.md section 6),
// pour rester simple sans figer un modèle polymorphe non validé. Jamais supprimable
// (seulement acknowledge/resolve) : pas de fonction deleteAlert.
model Alert {
  id                   String        @id @default(cuid())
  tenantId             String
  agencyId             String?
  userId               String?
  type                 AlertType
  priority             AlertPriority @default(MEDIUM)
  status               AlertStatus   @default(PENDING)
  message              String
  entityType           String?
  entityId             String?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  agency Agency? @relation(fields: [agencyId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([agencyId])
  @@index([userId])
  @@index([status])
  @@index([priority])
}

// Modèles NextAuth (Auth.js) requis par @auth/prisma-adapter.
// Sessions actives : JWT (cookie), pas de lecture de la table Session à chaque requête —
// voir HANDOFF.md pour la décision (conflit CredentialsProvider + stratégie "database").
// Account/Session/VerificationToken restent en place pour permettre l'ajout futur
// de fournisseurs OAuth sans nouvelle migration de schéma.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
