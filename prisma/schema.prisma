generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sprint 23 (DOMAINRULES.md section 39, remplace le verrou en mémoire de process du
  // Sprint 22 — DOMAINRULES.md section 38 point 4) : throttle des 13 vérifications d'alertes
  // planifiées (une exécution par tenant par heure), désormais porté en base pour rester
  // correct sur un déploiement multi-instance — voir maybeRunScheduledAlertChecks,
  // src/lib/scheduled-tasks.ts. Mis à jour par une seule instruction UPDATE ... WHERE
  // atomique (updateMany conditionné), jamais lu/écrit hors de cette garde.
  lastAlertCheckAt DateTime?

  agencies          Agency[]
  users             User[]
  vehicles          Vehicle[]
  locations         Location[]
  clients           Client[]
  invoices          Invoice[]
  payments          Payment[]
  maintenances      Maintenance[]
  alerts            Alert[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  reservations      Reservation[]
  permissionGroups  PermissionGroup[]
  cashRegister      CashRegister?
  cashEntries       CashEntry[]
  expenseCategories ExpenseCategory[]
  vehicleTransfers  VehicleTransfer[]
  vehicleTrips      VehicleTrip[]
  damages           Damage[]
  damageInvoices    DamageInvoice[]
}

model Agency {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  city         String?
  address      String?
  phone        String?
  email        String?
  managerName  String?
  managerPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Numérotation séquentielle des contrats, par agence (Sprint 15 — déplacé depuis Tenant,
  // DOMAINRULES.md section 29 : chaque agence a son propre préfixe et sa propre séquence,
  // indépendante des autres agences du même tenant). contractNumberPrefix est du texte libre
  // (ex. "RAK"), vide par défaut (aucun préfixe inventé — CLAUDE.md section 2).
  // lastContractNumber est le dernier numéro attribué pour cette agence : incrémenté
  // atomiquement à chaque nouveau contrat (Location) créé, jamais dérivé d'un COUNT()
  // (contrairement à Invoice.number) car l'énoncé exige de pouvoir le redéfinir manuellement
  // depuis les paramètres (reprise de numérotation après migration de données).
  contractNumberPrefix String @default("")
  lastContractNumber   Int    @default(0)

  // Solde de départ de caisse (Sprint 19) — purement informatif/de référence : la caisse
  // (CashRegister) reste un singleton par tenant (décision reconduite, voir son commentaire
  // ci-dessous), ce champ n'est jamais intégré au calcul réel du solde. Utile pour qu'une
  // agence garde trace du solde physique constaté à son ouverture, affiché sur la page Caisse.
  cashStartingBalance Int @default(0)

  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  userAgencies        UserAgency[]
  vehicles            Vehicle[]
  locations           Location[]        @relation("LocationAgency")
  locationsDroppedOff Location[]        @relation("LocationDropoffAgency")
  invoices            Invoice[]
  maintenances        Maintenance[]
  alerts              Alert[]
  transfersFrom       VehicleTransfer[] @relation("VehicleTransferFromAgency")
  transfersTo         VehicleTransfer[] @relation("VehicleTransferToAgency")
  vehicleTrips        VehicleTrip[]
  reservationsPickup  Reservation[]     @relation("ReservationPickupAgency")
  reservationsDropoff Reservation[]     @relation("ReservationDropoffAgency")
  cashEntries         CashEntry[]
  damageInvoices      DamageInvoice[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String?
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phone             String?
  avatar            String?
  permissionGroupId String?

  tenant                      Tenant            @relation(fields: [tenantId], references: [id])
  userAgencies                UserAgency[]
  accounts                    Account[]
  sessions                    Session[]
  alerts                      Alert[]
  sentInvitations             Invitation[]
  permissionGroup             PermissionGroup?  @relation(fields: [permissionGroupId], references: [id])
  userPermissions             UserPermission[]
  vehicleTransfersResponsible VehicleTransfer[] @relation("VehicleTransferResponsible")
  vehicleTrips                VehicleTrip[]
  // Sprint 26D (Finding D1) : agent à l'origine d'une correction/compensation de caisse.
  cashEntriesPerformed        CashEntry[]       @relation("CashEntryPerformedBy")
  // Sprint 32 : agent ayant déclaré un dégât (Damage.createdByUserId).
  damagesCreated              Damage[]          @relation("DamageCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([permissionGroupId])
}

model UserAgency {
  id        String   @id @default(cuid())
  userId    String
  agencyId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([userId, agencyId])
  @@index([agencyId])
}

enum IdType {
  CIN
  PASSEPORT
  CARTE_SEJOUR
}

// Client représente un locataire externe (personne qui loue un véhicule),
// distinct de User (compte staff du tenant, avec identifiants de connexion) —
// décision explicite Sprint 5, voir HANDOFF.md. firstName/lastName (Sprint 12A)
// s'ajoutent à `name` (conservé pour compatibilité avec tout le code/tests existants
// qui l'utilisent déjà comme libellé d'affichage) plutôt que de le remplacer ;
// `name` reste dérivé de "firstName lastName" côté formulaire dashboard.
model Client {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  altPhone          String?
  address           String?
  city              String?
  country           String?
  idNumber          String?
  idType            IdType?
  licenseNumber     String?
  licenseIssueDate  DateTime?
  licenseExpiryDate DateTime?
  // Sprint 30 (DOMAINRULES.md section 45, point 7) : âge réel du conducteur, distinct de
  // l'ancienneté du permis (licenseExpiryDate ci-dessus). Nullable — clients déjà créés avant ce
  // sprint n'en ont pas, jamais backfillée (même principe que licenseExpiryDate, Sprint 12A) ;
  // un client sans birthDate peut toujours exister (CLAUDE.md section 2 point 7 — pas de donnée
  // inventée), seule sa désignation comme conducteur d'un contrat est bloquée (voir
  // assertClientMeetsMinimumAge, src/lib/locations.ts).
  birthDate         DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant                   Tenant          @relation(fields: [tenantId], references: [id])
  locations                Location[]      @relation("LocationClient")
  secondDriverForLocations Location[]      @relation("LocationSecondDriver")
  invoices                 Invoice[]
  damageInvoices           DamageInvoice[]

  @@index([tenantId])
}

// TRANSFERRING/ON_TRIP (Sprint 14C) sont gérés automatiquement par src/lib/vehicle-transfers.ts/
// vehicle-trips.ts (jamais sélectionnables manuellement dans les formulaires véhicule) : posés au
// lancement d'un transfert/bon de déplacement, retirés (retour à AVAILABLE) à sa validation/
// annulation — seule dérogation à la règle "Vehicle.status reste un champ manuel" (DOMAINRULES.md
// section 5), nécessaire pour que les sélecteurs "?status=AVAILABLE" (locations/réservations)
// excluent automatiquement un véhicule en mobilité, sans dupliquer cette logique partout.
enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
  TRANSFERRING
  ON_TRIP
}

enum TransmissionType {
  MANUELLE
  AUTOMATIQUE
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
}

// Attributs professionnels (Sprint 12A) : tous optionnels au niveau schéma/API pour
// rester compatibles avec les véhicules déjà créés (sans ces champs) et avec les
// fixtures de test existantes qui créent un véhicule sans les fournir ; requis
// uniquement au niveau du formulaire dashboard (voir NewVehiclePage/EditVehicleForm).
model Vehicle {
  id            String            @id @default(cuid())
  tenantId      String
  agencyId      String
  name          String
  licensePlate  String
  make          String
  model         String
  year          Int
  category      String
  ww            String?
  chassisNumber String?
  color         String?
  doors         Int?
  seats         Int?
  transmission  TransmissionType?
  fuel          FuelType?
  horsepower    Int?
  powerKW       Int?
  engineSize    Float?
  ac            Boolean           @default(false)
  gps           Boolean           @default(false)
  imageUrl      String?
  status        VehicleStatus     @default(AVAILABLE)
  // Optionnel depuis le Sprint 14A : purement informatif, jamais la source de vérité de la
  // facturation (voir DOMAINRULES.md section 5/7) — le prix réel est saisi à la location/au
  // contrat (src/lib/locations.ts, createLocation).
  pricePerDay   Int?
  currency      String            @default("MAD")

  // Sprint 24 : kilométrage/carburant actuels du véhicule, capturés à la création — dernier
  // état connu avant toute Location/VehicleTransfer/VehicleTrip. Purement informatifs comme
  // pricePerDay ci-dessus : getVehicleLastKnownState (src/lib/vehicles.ts) les utilise
  // seulement comme repli quand aucun mouvement (retour de location/transfert/déplacement)
  // n'a encore renseigné de valeur plus récente. Optionnels (véhicules déjà existants n'en
  // ont pas, jamais backfillés — même principe que pricePerDay Sprint 14A).
  currentOdometer  Int?
  currentFuelLevel Int?

  // Champs proactifs pour les alertes métier (Sprint 19, DOMAINRULES section 37) : tous
  // optionnels (véhicules déjà existants n'en ont pas, jamais backfillés — même principe que
  // pricePerDay Sprint 14A) ; renseignés depuis la fiche véhicule, consultés par
  // scheduled-tasks.ts pour générer les alertes INSURANCE_EXPIRING/VIGNETTE_EXPIRING/
  // TECHNICAL_INSPECTION_DUE/OIL_CHANGE_DUE. Distinct de Maintenance (historique des
  // interventions déjà réalisées/planifiées) : ces champs représentent la prochaine échéance
  // connue, pas un événement en soi.
  insuranceExpiryDate           DateTime?
  vignetteExpiryDate            DateTime?
  technicalInspectionExpiryDate DateTime?
  nextOilChangeDate             DateTime?
  nextOilChangeKm               Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  agency       Agency            @relation(fields: [agencyId], references: [id])
  locations    Location[]
  maintenances Maintenance[]
  transfers    VehicleTransfer[]
  trips        VehicleTrip[]
  damages      Damage[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId])
  @@index([agencyId])
  @@index([status])
}

enum LocationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Location {
  id              String         @id @default(cuid())
  tenantId        String
  agencyId        String
  // Agence de retour (Sprint 19, DOMAINRULES section 37) : nullable, renseignée uniquement
  // quand une conversion de réservation a une dropoffAgency distincte de l'agence du véhicule
  // choisi (sinon null = "même agence que agencyId", pas de duplication). Permet au widget
  // "Retours" du dashboard et à la gestion de réception du véhicule d'être visibles à l'agence
  // d'arrivée réelle, pas seulement à l'agence de départ/rattachement du véhicule.
  dropoffAgencyId String?
  vehicleId       String
  clientId        String
  // Second conducteur (Sprint 19, DOMAINRULES section 37) : réutilise entièrement le modèle
  // Client existant (même flux de détection de doublon que le client principal) plutôt qu'un
  // modèle dédié — un second conducteur est une identité, pas un concept métier différent.
  // Nullable : la plupart des contrats n'en ont pas.
  secondDriverId  String?
  startDate       DateTime
  endDate         DateTime
  startOdometer   Int?
  endOdometer     Int?
  // Sprint 23 (DOMAINRULES.md section 39) : jauge de carburant départ/retour du contrat,
  // même convention que VehicleTransfer/VehicleTrip (pourcentage entier 0-100, jamais un
  // float — DOMAINRULES.md section 14) — absente jusqu'ici sur Location. Alimente aussi
  // getVehicleLastKnownState (src/lib/vehicles.ts), qui sélectionnait déjà endOdometer sur
  // Location mais renvoyait toujours fuelLevel: null faute de ce champ.
  startFuelLevel  Int?
  endFuelLevel    Int?
  status          LocationStatus @default(PENDING)
  pricePerDay     Int
  totalPrice      Int
  deposit         Int?
  currency        String         @default("MAD")
  notes           String?
  // Numéro de contrat séquentiel (Sprint 14B), ex. "RAK-00122" — voir generateContractNumber,
  // src/lib/locations.ts. Nullable : les Location déjà créées avant ce sprint n'en ont pas
  // (jamais backfillées rétroactivement, même principe que Vehicle.pricePerDay Sprint 14A) ;
  // toute nouvelle Location en reçoit un systématiquement, quel que soit son statut initial.
  contractNumber  String?
  // Sprint 32 : date/heure réelles du retour, distinctes de endDate (prévu). Préremplies par
  // le serveur à l'ouverture du formulaire de retour (jamais l'heure du navigateur seule) ;
  // modifiables uniquement par un titulaire de locations.return_time.edit — voir POST
  // .../return (non codé à cette étape, DOMAINRULES.md section 32).
  actualReturnAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  agency         Agency          @relation("LocationAgency", fields: [agencyId], references: [id])
  dropoffAgency  Agency?         @relation("LocationDropoffAgency", fields: [dropoffAgencyId], references: [id])
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  client         Client          @relation("LocationClient", fields: [clientId], references: [id])
  secondDriver   Client?         @relation("LocationSecondDriver", fields: [secondDriverId], references: [id])
  invoices       Invoice[]
  damages        Damage[]
  damageInvoices DamageInvoice[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId])
  @@index([agencyId])
  @@index([dropoffAgencyId])
  @@index([vehicleId])
  @@index([clientId])
  @@index([secondDriverId])
  @@index([status])
  @@index([startDate, endDate])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  OTHER
}

// Une facture (Invoice) est liée à une Location existante ; subtotal est un snapshot du
// Location.totalPrice au moment de la création (même logique de snapshot immuable que
// Location.pricePerDay vis-à-vis de Vehicle.pricePerDay, voir DOMAINRULES.md section 14).
// agencyId/clientId/currency sont toujours dérivés de la Location côté serveur, jamais
// fournis par le client (SECURITY.md section 4).
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  agencyId       String
  locationId     String
  clientId       String
  number         String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Int
  taxRate        Int           @default(0)
  taxAmount      Int           @default(0)
  discountAmount Int           @default(0)
  totalAmount    Int
  amountPaid     Int           @default(0)
  currency       String        @default("MAD")
  issuedAt       DateTime      @default(now())
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Sprint 26E : versionnement documentaire (jamais un avoir — pas de montant négatif, pas de
  // transfert de paiement, voir src/lib/invoices.ts, versionInvoice). Une facture SENT sans
  // aucun Payment peut être remplacée par une nouvelle facture DRAFT ; l'ancienne passe
  // CANCELLED, jamais supprimée ni réécrite dans ses montants — même principe append-only que
  // CashEntry.parentEntryId (Sprint 26D). replacesInvoiceId (sur la NOUVELLE facture) pointe
  // vers la version immédiatement précédente qu'elle remplace (null sur la toute première
  // facture d'une chaîne) — relation 1:1 réelle (@unique, une facture n'est jamais remplacée
  // deux fois) : l'ancienne facture est retrouvable dans l'autre sens via la relation inverse
  // `replacedBy` (jamais une colonne physique dupliquée — aucune information stockée deux fois).
  // rootInvoiceId pointe vers la toute première facture de la chaîne (null sur elle-même) —
  // relation N:1 (plusieurs versions peuvent partager la même racine), inverse `versions`.
  // versionNumber par défaut 1 pour toute facture déjà existante (aucun backfill d'historique).
  replacesInvoiceId String? @unique
  rootInvoiceId     String?
  versionNumber     Int     @default(1)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  agency   Agency    @relation(fields: [agencyId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  payments Payment[]

  replaces   Invoice?  @relation("InvoiceVersionChain", fields: [replacesInvoiceId], references: [id])
  replacedBy Invoice?  @relation("InvoiceVersionChain")
  root       Invoice?  @relation("InvoiceVersionRoot", fields: [rootInvoiceId], references: [id])
  versions   Invoice[] @relation("InvoiceVersionRoot")

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([agencyId])
  @@index([locationId])
  @@index([clientId])
  @@index([status])
  @@index([rootInvoiceId])
}

// Sprint 26D (Finding D1) : ACTIVE = paiement encaissé normal, jamais modifié par ce
// statut lui-même. REFUNDED = le contrat a été annulé (adminCancelValidatedLocation,
// src/lib/locations.ts) et ce paiement a été remboursé au client — le Payment reste
// conservé tel quel (amount/method/paidAt inchangés, jamais supprimé physiquement),
// seul ce statut change. Un Payment REFUNDED ne peut plus être corrigé ni remboursé
// une seconde fois (voir updatePaymentLocked/adminCancelValidatedLocation).
enum PaymentStatus {
  ACTIVE
  REFUNDED
}

// Un paiement enregistré manuellement (pas d'intégration Stripe/PayPal — décision
// explicite Sprint 6) contre une facture. Aucune donnée de carte bancaire n'est
// jamais saisie ni stockée ici (SECURITY.md) : `method`/`reference` ne décrivent que
// le mode de règlement (ex. "CARD" = paiement carte encaissé hors-ligne par l'agence).
//
// Sprint 33 (DOMAINRULES.md section 48) : un paiement pointe désormais soit `invoiceId`
// (paiement locatif), soit `damageInvoiceId` (paiement de dégât facturé séparément via
// DamageInvoice) — jamais les deux, jamais aucun des deux. Remplace le mécanisme provisoire du
// Sprint 32 (`Payment.damageId`, retiré ce sprint — plus aucun paiement de dégât direct sans
// DamageInvoice n'est possible). Contrainte d'exclusivité appliquée par un CHECK SQL (voir la
// migration) en plus de la validation applicative dans src/lib/payments.ts/damage-invoices.ts —
// défense en profondeur, même principe que le reste du projet (jamais une seule couche de
// validation pour une règle financière).
model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceId       String?
  damageInvoiceId String?
  amount          Int
  currency        String        @default("MAD")
  method          PaymentMethod
  paidAt          DateTime      @default(now())
  reference       String?
  notes           String?
  // Sprint 26D (Finding D1) : voir PaymentStatus ci-dessus.
  status          PaymentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  // onDelete: Restrict explicite (Sprint 33) : le défaut Prisma pour une relation optionnelle est
  // SET NULL, qui mettrait silencieusement les deux colonnes à null en cas de suppression de la
  // facture/DamageInvoice référencée — violerait la garantie « exactement une des deux »
  // (contrainte CHECK, voir la migration) plutôt que de la faire respecter. En pratique une
  // Invoice/DamageInvoice ayant des Payment n'est jamais supprimable (deleteInvoice/l'absence de
  // suppression sur DamageInvoice) ; Restrict rend cette garantie explicite au niveau base plutôt
  // que de dépendre uniquement de la couche applicative.
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  damageInvoice DamageInvoice? @relation(fields: [damageInvoiceId], references: [id], onDelete: Restrict)
  cashEntries   CashEntry[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([damageInvoiceId])
}

// CANCELLED (Sprint 33) : reflète l'annulation de la DamageInvoice à laquelle ce dégât est
// rattaché (cancelDamageInvoice, src/lib/damage-invoices.ts) — jamais réglé directement, même
// principe que les autres valeurs de cet enum.
enum DamageStatus {
  REPORTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// Dégât constaté sur un véhicule au retour d'un contrat (Sprint 32, DOMAINRULES.md section
// 32 — remplace le report explicite documenté aux Sprints 19/37 : "aucun code de ce module
// n'existe"). status dérivé automatiquement de l'état de sa DamageInvoice une fois facturé
// (applyDamageInvoiceStatus, src/lib/damages.ts — remplace au Sprint 33 la dérivation directe
// depuis Payment.damageId du Sprint 32, retirée), jamais réglé manuellement — même principe que
// Invoice.status vis-à-vis de Payment (recomputeInvoiceStatus). Jamais supprimé physiquement une
// fois créé (traçabilité, même principe append-only que CashEntry) ; une correction passe par
// damages.edit (nature/description/billableAmount, jamais une fois damageInvoiceId renseigné —
// le contenu facturé devient un snapshot immuable sur DamageInvoiceLine, voir son commentaire).
model Damage {
  id              String       @id @default(cuid())
  tenantId        String
  vehicleId       String
  locationId      String
  createdByUserId String?
  nature          String
  description     String?
  billableAmount  Int?
  currency        String       @default("MAD")
  status          DamageStatus @default(REPORTED)
  // Sprint 33 : renseigné une fois ce dégât facturé (createDamageInvoice, src/lib/damage-invoices.ts)
  // — jamais remis à null ensuite (même une DamageInvoice annulée conserve ce lien, traçabilité
  // append-only). Sert de garde d'idempotence directe : un dégât déjà rattaché à une DamageInvoice
  // ne peut plus jamais en recevoir une seconde (DamageAlreadyInvoicedError).
  damageInvoiceId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  vehicle       Vehicle            @relation(fields: [vehicleId], references: [id])
  location      Location           @relation(fields: [locationId], references: [id])
  createdByUser User?              @relation("DamageCreatedBy", fields: [createdByUserId], references: [id])
  // onDelete: Restrict explicite (Sprint 33), même raisonnement que Payment.invoice/damageInvoice
  // ci-dessus : Damage.damageInvoiceId ne doit jamais être remis à null silencieusement.
  damageInvoice DamageInvoice?     @relation(fields: [damageInvoiceId], references: [id], onDelete: Restrict)
  invoiceLine   DamageInvoiceLine?

  @@index([tenantId])
  @@index([vehicleId])
  @@index([locationId])
  @@index([status])
  @@index([damageInvoiceId])
}

enum DamageInvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// Facture de dégâts (Sprint 33, DOMAINRULES.md section 48) — remplace le paiement direct de
// dégât du Sprint 32 (Payment.damageId, retiré) : un dégât facturable généré au retour d'un
// contrat (returnLocation, src/lib/location-return.ts) produit toujours une DamageInvoice créée
// directement au statut SENT (jamais de brouillon éditable — ses lignes sont un snapshot
// immuable du formulaire de retour, voir DamageInvoiceLine). subtotal/totalAmount sont la somme
// des lignes ; amountPaid/status sont dérivés de la somme réelle des Payment liés
// (recomputeDamageInvoiceStatus, src/lib/damage-invoices.ts), même principe que
// Invoice.amountPaid/status vis-à-vis de Payment (recomputeInvoiceStatus, src/lib/payments.ts) —
// jamais réglés directement. Numéro au format "FACT-DEG-{5 chiffres}/{contractNumber}" (compteur
// séquentiel par tenant, voir generateDamageInvoiceNumber). Solde et paiements strictement
// séparés du solde/des paiements locatifs (Invoice/Payment.invoiceId) — jamais agrégés ensemble.
model DamageInvoice {
  id          String              @id @default(cuid())
  tenantId    String
  agencyId    String
  locationId  String
  clientId    String
  number      String
  status      DamageInvoiceStatus @default(DRAFT)
  subtotal    Int
  totalAmount Int
  amountPaid  Int                 @default(0)
  currency    String              @default("MAD")
  issuedAt    DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  agency   Agency              @relation(fields: [agencyId], references: [id])
  location Location            @relation(fields: [locationId], references: [id])
  client   Client              @relation(fields: [clientId], references: [id])
  lines    DamageInvoiceLine[]
  damages  Damage[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([agencyId])
  @@index([locationId])
  @@index([clientId])
  @@index([status])
}

// Ligne de facture de dégâts (Sprint 33) — snapshot immuable de nature/description/billableAmount
// au moment de la facturation (jamais réécrite ensuite, même si le Damage sous-jacent est modifié
// via damages.edit avant facturation — après facturation, damages.edit est de toute façon refusé,
// voir le commentaire sur Damage.damageInvoiceId) : garantit que la facture déjà émise au client
// reste fidèle à ce qui a été réellement facturé, indépendamment de toute correction ultérieure du
// Damage vivant. `damageId` est `@unique` : un dégât ne peut apparaître que sur une seule ligne,
// jamais deux (cohérent avec l'idempotence "un dégât n'est jamais facturé deux fois").
model DamageInvoiceLine {
  id              String   @id @default(cuid())
  damageInvoiceId String
  damageId        String   @unique
  nature          String
  description     String?
  billableAmount  Int
  currency        String   @default("MAD")
  createdAt       DateTime @default(now())

  damageInvoice DamageInvoice @relation(fields: [damageInvoiceId], references: [id])
  damage        Damage        @relation(fields: [damageId], references: [id])

  @@index([damageInvoiceId])
  @@index([damageId])
}

enum MaintenanceType {
  OIL_CHANGE
  TIRE_CHANGE
  INSPECTION
  REPAIR
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Suivi d'entretien d'un véhicule. agencyId est toujours dérivé du Vehicle côté
// serveur (même principe que Location.agencyId dérivé du Vehicle, voir DOMAINRULES.md
// section 7). Historique conservé : suppression bloquée dès que le statut est passé par
// IN_PROGRESS/COMPLETED (voir MaintenanceNotDeletableError, src/lib/maintenances.ts).
model Maintenance {
  id            String            @id @default(cuid())
  tenantId      String
  agencyId      String
  vehicleId     String
  type          MaintenanceType
  status        MaintenanceStatus @default(SCHEDULED)
  scheduledDate DateTime
  completedDate DateTime?
  cost          Int?
  currency      String            @default("MAD")
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  agency  Agency  @relation(fields: [agencyId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([agencyId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

enum VehicleTransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Transfert d'un véhicule entre deux agences d'un même tenant (Sprint 14C, DOMAINRULES.md
// section 30) — flux distinct de Location/Reservation : ne réserve rien pour un client, sert
// uniquement à déplacer un véhicule. fromAgencyId est toujours dérivé de Vehicle.agencyId côté
// serveur au lancement (même principe que Location.agencyId dérivé du véhicule) ; toAgencyId
// est fourni par l'appelant et validé comme appartenant au même tenant, différent de
// fromAgencyId. Le transfert est "lancé" dès sa création (status par défaut IN_TRANSIT) — pas
// d'étape brouillon distincte, cohérent avec la simplicité déjà en vigueur pour Maintenance
// (SCHEDULED → COMPLETED direct autorisé). Vehicle.status passe automatiquement à TRANSFERRING
// au lancement puis repasse à AVAILABLE (et Vehicle.agencyId à toAgencyId) à la validation —
// voir src/lib/vehicle-transfers.ts. Niveaux de carburant en pourcentage (0-100, Int) : aucune
// convention de jauge (1/4, 3/4...) n'existe ailleurs dans le projet, un entier simple évite
// d'inventer un format non validé tout en respectant l'interdiction des float (DOMAINRULES.md
// section 14 — bien que ceci ne soit pas un montant financier).
model VehicleTransfer {
  id                String                @id @default(cuid())
  tenantId          String
  vehicleId         String
  fromAgencyId      String
  toAgencyId        String
  fromCity          String?
  toCity            String?
  departureDate     DateTime              @default(now())
  arrivalDate       DateTime?
  startOdometer     Int?
  endOdometer       Int?
  startFuelLevel    Int?
  endFuelLevel      Int?
  responsibleUserId String
  // Sprint 22 : nom du chauffeur effectif à l'arrivée (texte libre — peut différer du
  // responsibleUserId, choisi à la création parmi les users du tenant ; le chauffeur réel
  // n'est pas nécessairement un compte User, ex. chauffeur externe) — renseigné à la
  // validation (voir validateVehicleTransfer, src/lib/vehicle-transfers.ts).
  arrivalDriverName String?
  reason            String?
  status            VehicleTransferStatus @default(IN_TRANSIT)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id])
  fromAgency      Agency  @relation("VehicleTransferFromAgency", fields: [fromAgencyId], references: [id])
  toAgency        Agency  @relation("VehicleTransferToAgency", fields: [toAgencyId], references: [id])
  responsibleUser User    @relation("VehicleTransferResponsible", fields: [responsibleUserId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
  @@index([fromAgencyId])
  @@index([toAgencyId])
}

enum VehicleTripStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Bon de déplacement interne (Sprint 14C, DOMAINRULES.md section 30) : déplacement
// professionnel d'un véhicule par un employé du tenant, sans passer par Location/Reservation
// (aucun client, aucune facturation). Départ automatique à la création (departureDate = now,
// status IN_PROGRESS par défaut) — kilométrage/carburant de départ saisis à ce moment ;
// kilométrage/carburant de retour saisis à la validation (returnVehicleTrip,
// src/lib/vehicle-trips.ts), qui exige endOdometer strictement supérieur à startOdometer
// (contrainte explicite du sprint). Vehicle.status passe automatiquement à ON_TRIP au départ
// puis repasse à AVAILABLE au retour/à l'annulation. agencyId est toujours dérivé du véhicule
// côté serveur (même principe que Maintenance.agencyId).
model VehicleTrip {
  id             String            @id @default(cuid())
  tenantId       String
  vehicleId      String
  agencyId       String
  employeeUserId String
  reason         String
  destination    String
  departureDate  DateTime          @default(now())
  returnDate     DateTime?
  startOdometer  Int
  endOdometer    Int?
  startFuelLevel Int?
  endFuelLevel   Int?
  remarks        String?
  status         VehicleTripStatus @default(IN_PROGRESS)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id])
  agency       Agency  @relation(fields: [agencyId], references: [id])
  employeeUser User    @relation(fields: [employeeUserId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([agencyId])
  @@index([status])
}

// CONTRACT_AT_RISK/PAYMENT_DUE/VEHICLE_UNAVAILABLE/RETURN_OVERDUE/DOCUMENT_EXPIRED/
// STOCK_INCONSISTENCY ajoutés Sprint 14C (DOMAINRULES.md section 30) — voir
// src/lib/scheduled-tasks.ts pour la logique de génération de chacune.
enum AlertType {
  MAINTENANCE_DUE
  RETURN_TODAY
  INVOICE_OVERDUE
  CONTRACT_AT_RISK
  PAYMENT_DUE
  VEHICLE_UNAVAILABLE
  RETURN_OVERDUE
  DOCUMENT_EXPIRED
  STOCK_INCONSISTENCY
  INSURANCE_EXPIRING
  VIGNETTE_EXPIRING
  TECHNICAL_INSPECTION_DUE
  OIL_CHANGE_DUE
  // Sprint 22 : alerte envoyée à l'agence d'arrivée dès le lancement d'un transfert entre
  // agences (voir createVehicleTransfer, src/lib/vehicle-transfers.ts) — distincte des
  // vérifications planifiées existantes ci-dessus, créée immédiatement (pas via
  // scheduled-tasks.ts).
  VEHICLE_TRANSFER_INCOMING
  OTHER
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

// Alerte in-app (pas d'email pour ce sprint, voir HANDOFF.md). agencyId/userId sont
// optionnels : une alerte peut être diffusée à tout le tenant (agencyId/userId null),
// scopée à une agence, ou assignée à un user précis. entityType/entityId pointent en
// texte libre vers la ressource à l'origine de l'alerte (ex. "Maintenance"/id), sans
// contrainte de clé étrangère — cohérent avec Vehicle.category (DOMAINRULES.md section 6),
// pour rester simple sans figer un modèle polymorphe non validé. Jamais supprimable
// (seulement acknowledge/resolve) : pas de fonction deleteAlert.
model Alert {
  id                    String        @id @default(cuid())
  tenantId              String
  agencyId              String?
  userId                String?
  type                  AlertType
  priority              AlertPriority @default(MEDIUM)
  status                AlertStatus   @default(PENDING)
  message               String
  entityType            String?
  entityId              String?
  acknowledgedAt        DateTime?
  acknowledgedByUserId  String?
  resolvedAt            DateTime?
  resolvedByUserId      String?
  // Sprint 22 : formulaire de suivi renseigné à la résolution (voir resolveAlert,
  // src/lib/alerts.ts) — trace l'action effectuée sur l'échéance/le document concerné,
  // jusqu'à clôture, et reste consultable sur la fiche véhicule (entityId) une fois résolue.
  // Tous optionnels : une alerte "simple" (ex. retour du jour) peut être résolue sans ce détail.
  resolutionAction      String?
  resolutionDate        DateTime?
  resolutionIntervenant String?
  resolutionCost        Int?
  resolutionCurrency    String?
  nextDueDate           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  agency Agency? @relation(fields: [agencyId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([agencyId])
  @@index([userId])
  @@index([status])
  @@index([priority])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Invitation d'un nouvel utilisateur dans un tenant existant (Sprint 9). Pas de colonne
// `token` séparée : `id` (cuid, haute entropie) sert directement d'identifiant non-devinable
// dans le lien partageable — cohérent avec le reste du schéma qui utilise déjà cuid() comme
// identifiant opaque partout (véhicules, locations...). Aucun envoi d'email (décision Sprint 7
// reconduite) : le lien est partagé manuellement par l'ADMIN depuis /dashboard/invitations.
model Invitation {
  id              String           @id @default(cuid())
  tenantId        String
  email           String
  role            String           @default("MEMBER")
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation(fields: [invitedByUserId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([status])
}

// Journal d'audit (Sprint 9), scopé tenant. userId nullable : l'acteur peut avoir été
// supprimé depuis (deleteUser ne doit jamais échouer à cause de l'audit). Portée volontairement
// limitée aux actions sensibles introduites par ce sprint (rôle/suppression user, invitations) —
// pas de rétrofit sur le reste du CRUD existant, voir HANDOFF.md.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([resource])
  @@index([createdAt])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CONVERTED
  CANCELLED
  // Sprint 23 (DOMAINRULES.md section 39) : le client ne s'est jamais présenté — distinct de
  // CANCELLED (client venu mais véhicule refusé/conditions non respectées). Terminal comme
  // CANCELLED/CONVERTED, sauf reset explicite par un ADMIN (resetReservationToPending,
  // src/lib/reservations.ts).
  NO_SHOW
}

// Réservation importée (Excel) ou saisie manuellement, en amont d'un contrat (Location).
// Sprint 12C. pickupAgency/dropoffAgency/vehicleCategory restent du texte libre (comme
// Vehicle.category, Alert.entityType — DOMAINRULES.md section 6) : les données d'un
// import Excel/broker ne correspondent pas fiablement à une Agency/Vehicle existante ;
// la sélection du véhicule/agence réels se fait au moment de la conversion en contrat
// (convertReservationToLocation, src/lib/reservations.ts), jamais déduite automatiquement
// du texte importé. Montants en centimes (Int), jamais en float (DOMAINRULES.md section 14).
// source est du texte libre (Sprint 15, même principe que vehicleCategory ci-dessus) — un
// enum fermé (BROKER/DIRECT) masquait silencieusement les codes broker réels (TJS/DCH/CT...)
// importés depuis Excel, affichés en tiret cantonné faute de correspondance. currency
// s'applique à totalPrice/pricePerDay ; optionsCurrency (Sprint 15) s'applique séparément à
// gpsPrice/babySeatPrice/extraDriverPrice, qui peuvent être dans une devise différente du
// prix total selon le broker (ex. total en EUR, options toujours en MAD).
model Reservation {
  id                  String            @id @default(cuid())
  tenantId            String
  voucherNumber       String
  confirmationNumber  String?
  receivedAt          DateTime?
  source              String?
  clientFirstName     String
  clientLastName      String
  startDate           DateTime
  startTime           String?
  endDate             DateTime
  endTime             String?
  daysCount           Int?
  flightNumber        String?
  currency            String            @default("MAD")
  totalPrice          Int?
  pricePerDay         Int?
  vehicleCategory     String?
  pickupAgency        String?
  dropoffAgency       String?
  // Résolution serveur de pickupAgency/dropoffAgency (texte libre ci-dessus, inchangé — un
  // import broker peut désigner une ville qui ne correspond à aucune Agency réelle) vers une
  // Agency réelle du tenant quand le texte correspond (Sprint 19, DOMAINRULES section 37) :
  // sert uniquement à la visibilité/l'autorisation par agence (getAccessibleAgencyIds), jamais
  // à l'affichage (qui reste basé sur le texte libre). Null si aucune correspondance — dans ce
  // cas la réservation reste visible à quiconque a la permission reservations.view, comportement
  // inchangé par rapport à avant ce sprint (pas de régression sur l'import Excel/broker).
  pickupAgencyId      String?
  dropoffAgencyId     String?
  hasGps              Boolean           @default(false)
  gpsPrice            Int?
  hasBabySeat         Boolean           @default(false)
  babySeatPrice       Int?
  hasExtraDriver      Boolean           @default(false)
  extraDriverPrice    Int?
  optionsCurrency     String            @default("MAD")
  mileage             Int?
  includedKm          Int?
  clientPhone         String?
  notes               String?
  status              ReservationStatus @default(PENDING)
  convertedLocationId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  pickupAgencyRef  Agency? @relation("ReservationPickupAgency", fields: [pickupAgencyId], references: [id])
  dropoffAgencyRef Agency? @relation("ReservationDropoffAgency", fields: [dropoffAgencyId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([voucherNumber])
  @@index([pickupAgencyId])
  @@index([dropoffAgencyId])
}

// Système de permissions granulaires (Sprint 12C), en complément — pas en remplacement —
// du rôle ADMIN/MEMBER existant et de canAccessAgency() : un ADMIN a toujours accès à
// tout (bypass, voir src/lib/permissions.ts, can()) ; un MEMBER voit ses permissions
// effectives dérivées de son PermissionGroup + ses UserPermission individuelles
// (additives). Le catalogue des clés de permission (ex. "vehicles.view") vit en code
// (src/lib/permissions.ts, PERMISSIONS) et pas dans une table dédiée : GroupPermission/
// UserPermission stockent la clé en texte libre, sans contrainte de clé étrangère —
// même principe que Alert.entityType/Vehicle.category (DOMAINRULES.md section 6),
// pour ne pas avoir de table de référence à garder synchronisée avec le code.
// Portée de cette version (Sprint 12C) : seul le nouveau module Reservation applique ces
// permissions côté serveur ; les modules existants gardent leurs vérifications de rôle/
// agence actuelles inchangées (voir HANDOFF.md et SECURITY.md).
model PermissionGroup {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  groupPermissions GroupPermission[]
  users            User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GroupPermission {
  id            String   @id @default(cuid())
  groupId       String
  permissionKey String
  createdAt     DateTime @default(now())

  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, permissionKey])
  @@index([groupId])
}

model UserPermission {
  id            String   @id @default(cuid())
  userId        String
  permissionKey String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([userId])
}

enum CashEntryType {
  ENTRY
  EXPENSE
}

// Caisse (Sprint 13A) : un CashRegister par tenant (singleton, @@unique tenantId), pas
// de notion d'agence (comme Reservation, section 21 DOMAINRULES) — tous les CashEntry
// d'un tenant alimentent une caisse unique. currentBalance/currentMonth/previousBalance
// ne sont jamais incrémentés directement : ils sont recalculés en entier à partir des
// CashEntry réels après chaque écriture (recomputeCashRegisterBalance, src/lib/cash-register.ts),
// même principe que Invoice.amountPaid/status vis-à-vis de Payment (DOMAINRULES section 10)
// — pour ne jamais laisser un solde dériver de la réalité des écritures.
model CashRegister {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  currentBalance  Int      @default(0)
  currentMonth    String
  previousBalance Int      @default(0)
  currency        String   @default("MAD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  entries CashEntry[]

  @@index([tenantId])
}

// Écriture de caisse (entrée ou dépense), jamais modifiable ni supprimable une fois créée
// (même principe append-only que Alert, DOMAINRULES section 19 — traçabilité financière).
// contractId pointe en texte libre vers une Location (pas de contrainte de clé étrangère,
// même principe que Alert.entityType/Vehicle.category, DOMAINRULES section 6) : une location
// supprimée ne doit jamais bloquer/casser son historique de caisse. category est également
// du texte libre (nom d'ExpenseCategory pour une dépense, ou une des valeurs suggérées
// VERSEMENT/COMMISSION/VIREMENT pour une entrée) plutôt qu'un enum figé, pour rester
// extensible sans migration à chaque nouvelle catégorie.
model CashEntry {
  id             String         @id @default(cuid())
  tenantId       String
  cashRegisterId String
  type           CashEntryType
  category       String?
  amount         Int
  currency       String         @default("MAD")
  description    String?
  // Sprint 22 : agence d'origine de l'écriture — nullable (une caisse reste un singleton par
  // tenant, DOMAINRULES.md section 23, décision reconduite ; ce champ ne restructure pas
  // CashRegister, il permet seulement de dériver un solde/CA *par agence* en plus du solde
  // global). Dérivé automatiquement de Location.agencyId pour une écriture issue d'un paiement
  // (recordPaymentCashEntry, src/lib/payments.ts) ; choisi explicitement pour une écriture
  // manuelle. FK réelle (contrairement à contractId, volontairement sans contrainte pour ne
  // jamais dépendre de l'existence continue d'une Location) : une agence n'est jamais purgée
  // en pratique (bloquée tant que des véhicules/locations y sont rattachés), donc conserver
  // l'intégrité référentielle ici est sans risque pour l'historique de caisse.
  agencyId       String?
  contractId     String?
  // Numéro de contrat au moment de l'écriture (Sprint 14B) — dénormalisé pour l'affichage
  // (même principe que clientName ci-dessous) : évite une jointure vers Location, qui peut
  // ne plus exister (contractId n'a pas de contrainte de clé étrangère, voir plus haut).
  contractNumber String?
  clientName     String?
  paymentMethod  PaymentMethod?
  createdAt      DateTime       @default(now())

  // Sprint 26D (Finding D1) : lien fiable vers le Payment source — contrairement à
  // contractId (volontairement sans FK, voir plus haut), ces colonnes bénéficient
  // d'une contrainte réelle : Payment/CashEntry ne sont jamais supprimés physiquement
  // une fois reflétés en caisse (append-only), l'intégrité référentielle est donc sans
  // risque pour l'historique. paymentId = le Payment concerné (original ET
  // compensations). parentEntryId = la CashEntry originale que cette ligne compense ;
  // NULL sur une écriture originale, renseigné uniquement sur une compensation — jamais
  // l'inverse (une écriture originale n'est jamais modifiée, seule une nouvelle ligne
  // liée est ajoutée). reason/performedByUserId ne sont renseignés que sur les
  // compensations (motif obligatoire applicatif, voir src/lib/payments.ts) — NULL sur
  // toute écriture d'origine (versement normal, jamais de motif à saisir).
  paymentId         String?
  parentEntryId     String?
  reason            String?
  performedByUserId String?

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
  agency          Agency?      @relation(fields: [agencyId], references: [id])
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  parentEntry     CashEntry?   @relation("CashEntryCorrections", fields: [parentEntryId], references: [id])
  corrections     CashEntry[]  @relation("CashEntryCorrections")
  performedByUser User?        @relation("CashEntryPerformedBy", fields: [performedByUserId], references: [id])

  @@index([tenantId])
  @@index([cashRegisterId])
  @@index([type])
  @@index([createdAt])
  @@index([agencyId])
  @@index([paymentId])
  @@index([parentEntryId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Modèles NextAuth (Auth.js) requis par @auth/prisma-adapter.
// Sessions actives : JWT (cookie), pas de lecture de la table Session à chaque requête —
// voir HANDOFF.md pour la décision (conflit CredentialsProvider + stratégie "database").
// Account/Session/VerificationToken restent en place pour permettre l'ajout futur
// de fournisseurs OAuth sans nouvelle migration de schéma.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
